APP_ENV=development
PORT=8001
LOG_LEVEL=INFO
INTERNAL_API_KEY=development-internal-key
# Empty key = deterministic template only (no LLM call)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=12
OPENROUTER_APP_URL=
OPENROUTER_PROVIDER_SORT=
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=false

# Cloudflare R2 (corpus PDF for RAG)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=setagama-core
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# RAG
RAG_MODEL=google/gemma-4-26b-a4b-it

# --- Production (Railway) ---
# APP_ENV=production refuses the dev INTERNAL_API_KEY.
# Mount a volume at /models and set RAILWAY_RUN_UID=0 so the embed/rerank models survive redeploys. Needs ~4 GB RAM.

# Chroma corpus folder (downloaded from R2 on start if missing)
# CHROMA_PATH=artifacts/chroma_corpus_v1

# --- Tracing (Arize Phoenix) -------------------------------------------------------------------
# Off unless PHOENIX_COLLECTOR_ENDPOINT is set. See docs/TRACING.md.
# Local Phoenix:  PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
# Phoenix Cloud:  PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<your-space>  (and PHOENIX_API_KEY)
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=finpass-ai
# TRACING_ENABLED=false forces it off even when an endpoint is set.
TRACING_ENABLED=
# Export prompts, questions and answers. Empty means: on in development, off in production
# (prompts carry a person's financial data). Tokens, cost, models, scores and timings are always sent.
TRACING_CAPTURE_CONTENT=
# Sample a share of traces (head sampling), e.g. 20% in production:
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2

# Sentry error reporting. Off when empty. Keep the real value in .env or the platform, not in git.
SENTRY_DSN=
