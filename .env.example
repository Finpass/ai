APP_ENV=development
PORT=8001
LOG_LEVEL=INFO
INTERNAL_API_KEY=development-internal-key
# Empty key = deterministic template only (no LLM call)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=12
OPENROUTER_APP_URL=
OPENROUTER_PROVIDER_SORT=
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true

# Cloudflare R2 (corpus PDF for RAG)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=setagama-core
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_API_TOKEN=

# RAG
DATABASE_URL=
RAG_MODEL=google/gemma-4-26b-a4b-it
